# Copy to .env and fill in real values. Never commit .env.
# Any adapter whose key is left blank runs in deterministic MOCK mode automatically.

# --- Hostify ---
# If set: HostifyAdapter (live) is used.
# If blank: HostifyMockAdapter is used, and startup logs will say so.
HOSTIFY_API_KEY=

# --- PriceLabs ---
# Not yet available for this project. Leave blank until a PriceLabs
# account/API key exists; the pricing engine will keep running against
# deterministic mock market signals in the meantime.
PRICELABS_API_KEY=

# --- Microsoft Graph (Excel/Outlook/OneDrive/SharePoint) ---
# Requires an Azure AD App Registration on the SD Stay tenant.
# Not yet configured for this project (Phase 2+).
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# --- Claude API (report/dashboard generation, later phases) ---
ANTHROPIC_API_KEY=

# --- Auth (Phase 3) ---
# HMAC signing secret for JWT access tokens. REQUIRED in production — if
# left blank, the API generates a random ephemeral secret at boot and logs
# a loud warning; all sessions are invalidated on every restart in that case.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Bootstraps the first admin user on startup, only if no admin exists yet.
# Leave blank to skip bootstrap and create the first admin manually via SQL.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- App ---
PORT=4000
API_URL=http://api:4000
DEFAULT_PROPERTY_ID=1001

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xlnc
POSTGRES_PASSWORD=change_me_in_env_only
POSTGRES_DB=xlnc_platform
